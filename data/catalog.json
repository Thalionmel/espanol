  "grammar": [
    {
      "id": "g-quiero-infinitive",
      "pattern": "Quiero + infinitive",
      "meaning": "I want to do something.",
      "status": "used_successfully",
      "explanation": "The verb after quiero stays in its basic form: Quiero revisar esto.",
      "observationIds": [
        "o-quiero",
        "o-independent"
      ],
      "nextReview": "Combine with different familiar verbs without a model.",
      "lastPractised": "2026-11-10",

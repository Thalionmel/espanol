        "2026-11-10-01"
      ]
    },
    {
      "id": "g-porque",
      "pattern": "statement + porque + reason",
      "meaning": "Give a reason using because.",
      "status": "used_successfully",
      "explanation": "Quiero revisar esto porque es importante.",
      "observationIds": [
        "o-porque",
        "o-independent"
      ],
      "nextReview": "Use a new work-related reason, then revisit after a gap.",
      "lastPractised": "2026-11-10",
      "sessionIds": [
        "2026-11-10-01"
      ]
    },
    {
      "id": "g-querer-person",
      "pattern": "quiero / queremos",
      "meaning": "I want / we want.",
      "status": "used_with_correction",
      "explanation": "Quiero is first-person singular; queremos is first-person plural. The plural is not quieremos.",
      "observationIds": [
        "o-work-transfer"
      ],
      "nextReview": "Contrast Quiero revisar esto with Queremos revisar esto.",
      "lastPractised": "2026-11-10",
      "sessionIds": [
        "2026-11-10-01"
      ]
    },
    {
      "id": "g-negation",
      "pattern": "no + conjugated verb",
      "meaning": "Negate a statement.",
      "status": "used_with_correction",
      "explanation": "No es correcto means It isn't correct.",
      "observationIds": [
        "o-negation"
      ],
      "nextReview": "Elicit no es importante or no es correcto without supplying no.",
      "lastPractised": "2026-11-10",
      "sessionIds": [
        "2026-11-10-01"
      ]
    },
    {
      "id": "g-location",
      "pattern": "estar for location",
      "meaning": "Say where someone or something is.",
      "status": "used_with_correction",
      "explanation": "Use estar for a person's location: Está en Granada. Ser/estar has other uses that have not yet been taught.",
